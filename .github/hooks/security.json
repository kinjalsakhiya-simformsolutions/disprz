{
  "hooks": [
    {
      "hookType": "sessionStart",
      "name": "Session Logger",
      "description": "Logs when agent sessions begin",
      "command": "echo Session started at %DATE% %TIME% >> .github/hooks/session-log.txt"
    },
    {
      "hookType": "preToolUse",
      "name": "Tool Execution Logger",
      "description": "Logs all tool executions",
      "command": "echo Tool executed at %DATE% %TIME% >> .github/hooks/tool-log.txt"
    }
  ]
}
